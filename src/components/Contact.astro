---
import Giant from './Giant.astro';
import { person } from '../data/site';
import { u } from '../data/url';
const showCv = person.cv.ready || import.meta.env.DEV;
---
<section class="section contact wrap" id="contact" aria-labelledby="contact-title">
  <Giant lines={["Let's", 'talk']} id="contact-title" />
  <div class="contact__grid" data-reveal-group>
    <p class="contact__lead" data-reveal>Hiring for a marketing role? I'd like to hear about it.</p>
    <a class="contact__email" href={`mailto:${person.email}`} data-reveal>{person.email}</a>
    <ul class="contact__links" data-reveal>
      <li><a class="btn btn--primary" href={person.whatsapp} target="_blank" rel="noopener">WhatsApp {person.phone}</a></li>
      <li><a class="btn" href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      {showCv && <li><a class="btn" href={u(person.cv.file)} download>Download CV</a></li>}
    </ul>
  </div>
</section>

<style>
  .contact__grid { display: grid; gap: 28px; }
  .contact__lead { font-size: clamp(18px, 1.6vw, 22px); margin: 0; max-width: 40ch; }
  .contact__email {
    justify-self: start;
    font-size: clamp(28px, 5.2vw, 72px);
    font-weight: 500; letter-spacing: -0.03em; line-height: 1.05;
    word-break: break-all;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0% 3px; background-position: 0 100%; background-repeat: no-repeat;
    padding-bottom: 6px;
    transition: background-size 600ms var(--ease-out), color 300ms;
  }
  .contact__email:hover { background-size: 100% 3px; color: var(--accent); }
  .contact__links { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
