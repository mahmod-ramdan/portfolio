---
import { Image } from 'astro:assets';
import portrait from '../assets/brand/portrait-hero-tall.jpg';
import { person } from '../data/site';
import { u } from '../data/url';
const words = person.heroLine.split(' ');
const showCv = person.cv.ready || import.meta.env.DEV;
---
<section class="hero" data-hero aria-labelledby="hero-name">
  <div class="hero__photo" data-hero-photo>
    <Image
      src={portrait}
      alt="Mahmoud Ramadan, black and white portrait"
      widths={[480, 704]}
      sizes="(max-width: 860px) 100vw, 44vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="hero__inner wrap">
    <div class="hero__copy">
      <p class="hero__line" data-hero-line>
        {words.map((w, i) => <Fragment><span class="wm"><span class="w">{w}</span></span>{i < words.length - 1 ? ' ' : ''}</Fragment>)}
      </p>
      <ul class="hero__facts" data-hero-fade>
        {person.facts.map((f) => <li class="pill">{f}</li>)}
      </ul>
      <div class="hero__cta" data-hero-fade>
        <a class="btn btn--primary" href={u('#work')}>View my work</a>
        {showCv && <a class="btn" href={u(person.cv.file)} download>Download CV</a>}
      </div>
    </div>

    <h1 class="hero__name display" id="hero-name" data-hero-name>
      <span class="line"><span>{person.first}</span></span>
      <span class="line"><span>{person.last}</span></span>
    </h1>
  </div>

  <div class="hero__cue" data-hero-cue aria-hidden="true">
    <span>Scroll</span><i></i>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-top: 96px;
    overflow: hidden;
  }
  .hero__photo {
    position: absolute;
    top: 0;
    right: max(0px, calc((100vw - var(--maxw)) / 2 - 40px));
    width: min(44vw, 640px);
    height: 108%;
    z-index: 0;
    will-change: transform;
    -webkit-mask-image: linear-gradient(to bottom, #000 50%, transparent 86%), linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, #000 50%, transparent 86%), linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
    mask-composite: intersect;
  }
  .hero__photo :global(img) {
    width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 18%;
  }

  .hero__inner {
    position: relative; z-index: 1;
    display: grid;
    gap: clamp(28px, 4vw, 48px);
    padding-bottom: clamp(36px, 6vh, 64px);
  }
  .hero__copy { max-width: 34rem; }
  .hero__line {
    font-size: clamp(26px, 2.9vw, 42px);
    line-height: 1.18;
    font-weight: 400;
    letter-spacing: -0.015em;
    margin: 0 0 24px;
    text-wrap: balance;
  }
  .wm { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .w { display: inline-block; }
  .hero__facts { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }

  .hero__name {
    font-size: clamp(84px, 16.5vw, 268px);
    line-height: 0.86;
    letter-spacing: -0.01em;
    margin-left: -0.045em;
    pointer-events: none;
  }
  .hero__name .line:last-child { padding-left: 0.62em; }

  .hero__cue {
    position: absolute; right: var(--gutter); bottom: 28px; z-index: 2;
    display: flex; align-items: center; gap: 12px;
    font-size: 12px; color: var(--text-muted); letter-spacing: 0.04em;
  }
  .hero__cue i { position: relative; width: 1.5px; height: 44px; background: var(--line); overflow: hidden; }
  .hero__cue i::after {
    content: ''; position: absolute; left: 0; right: 0; top: -40%; height: 40%;
    background: var(--accent);
    animation: cue 2.2s var(--ease-in-out) infinite;
  }
  @keyframes cue { to { top: 100%; } }

  @media (max-width: 860px) {
    .hero { display: block; padding-top: 0; min-height: 0; }
    .hero__photo {
      position: relative; right: auto; width: 100%; height: 74svh; max-height: 620px;
      -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 92%);
      mask-image: linear-gradient(to bottom, #000 55%, transparent 92%);
    }
    .hero__inner { margin-top: -0.9em; padding-bottom: 48px; display: flex; flex-direction: column-reverse; gap: 28px; }
    .hero__name { font-size: clamp(72px, 23vw, 140px); }
    .hero__name .line:last-child { padding-left: 0; }
    .hero__inner { margin-top: calc(-1 * clamp(72px, 23vw, 140px) * 1.3); }
    .hero__cue { display: none; }
  }
</style>
