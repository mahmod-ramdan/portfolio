---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Giant from '../components/Giant.astro';
import Stages from '../components/Stages.astro';
import Todo from '../components/Todo.astro';
import { u } from '../data/url';
const items = await getCollection('lab');
---
<Base title="Lab | Mahmoud Ramadan" description="Research and strategy work by Mahmoud Ramadan.">
  <section class="lab wrap">
    <a class="back link" href={u('work')}>All work</a>
    <Giant lines={['Lab']} as="h1" />
    <p class="intro" data-reveal>Research, positioning and strategy work. Smaller projects, but they show how I think before anything goes live.</p>
    <ul class="items" data-reveal-group>
      {items.map((it) => (
        <li class="item" data-reveal>
          <div class="item__head">
            {it.data.companyUrl
              ? <a class="item__company display" href={it.data.companyUrl} target="_blank" rel="noopener">{it.data.company}</a>
              : <span class="item__company display">{it.data.company}</span>}
            <span class="pill pill--muted">{it.data.type}</span>
          </div>
          <h2 class="item__title">{it.data.title}</h2>
          <p class="item__summary">{it.data.summary}</p>
          {it.data.insight && <p class="item__insight"><strong>Key insight.</strong> {it.data.insight}</p>}
          {it.data.wentLive && <p class="item__live"><strong>What went live.</strong> {it.data.wentLive}</p>}
          <Stages lit={it.data.stages} size="sm" />
          <Todo items={it.data.todos} />
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .lab { padding-top: clamp(120px, 14vw, 180px); }
  .back { display: inline-block; font-size: 14px; color: var(--text-muted); margin-bottom: clamp(24px, 4vw, 40px); }
  .intro { font-size: clamp(18px, 1.6vw, 22px); max-width: 46ch; margin-bottom: 48px; }
  .items { display: grid; gap: 16px; }
  .item { display: grid; gap: 16px; padding: clamp(24px, 3vw, 40px); border-radius: 20px; border: 1px solid var(--line); background: var(--bg-elev); }
  .item__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .item__company { font-size: clamp(32px, 3.6vw, 52px); line-height: 0.95; }
  a.item__company:hover { color: var(--accent); }
  .item__title { font-size: clamp(20px, 2vw, 28px); font-weight: 400; line-height: 1.3; }
  .item__summary { margin: 0; color: var(--text-muted); max-width: 62ch; }
  .item__insight, .item__live { margin: 0; max-width: 62ch; }
  .item strong { font-weight: 500; color: var(--accent); }
</style>
