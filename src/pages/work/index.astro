---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Giant from '../../components/Giant.astro';
import Stages from '../../components/Stages.astro';
import { stages, industries } from '../../data/site';
import { u } from '../../data/url';

const all = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const usedIndustries = industries.filter((i) => all.some((c) => c.data.industry.includes(i)));
---
<Base title="Work | Mahmoud Ramadan" description="Case studies: media buying, content strategy, research and client work for EdTech, B2B, retail and consumer-tech brands.">
  <section class="work wrap">
    <Giant lines={['Work']} as="h1" />
    <p class="work__intro" data-reveal>Every case shows what was broken, what I did, and what changed. Filter by the part of the cycle or by industry.</p>

    <div class="filters" data-filters data-reveal>
      <div class="filters__row" role="group" aria-label="Filter by stage">
        <span class="filters__label">Stage</span>
        <button class="chip is-on" type="button" data-filter="stage" data-value="all" aria-pressed="true">All</button>
        {stages.map((s) => <button class="chip" type="button" data-filter="stage" data-value={s.id} aria-pressed="false">{s.short}</button>)}
      </div>
      <div class="filters__row" role="group" aria-label="Filter by industry">
        <span class="filters__label">Industry</span>
        <button class="chip is-on" type="button" data-filter="industry" data-value="all" aria-pressed="true">All</button>
        {usedIndustries.map((i) => <button class="chip" type="button" data-filter="industry" data-value={i} aria-pressed="false">{i}</button>)}
      </div>
    </div>

    <ul class="cards" data-cards>
      {all.map((c) => (
        <li class:list={['card', { 'card--featured': c.data.tier === 'featured' }]} data-card data-stages={c.data.stages.join(' ')} data-industry={c.data.industry.join('|')}>
          <a href={u(`work/${c.id}`)} class="card__link">
            <span class="card__media">
              {c.data.cover
                ? <Image src={c.data.cover} alt="" widths={[480, 900]} sizes="(max-width: 860px) 100vw, 50vw" />
                : c.data.logo
                  ? <span class="card__logo"><Image src={c.data.logo} alt="" height={160} /></span>
                  : <span class="card__mono display" aria-hidden="true">{c.data.company}</span>}
            </span>
            <span class="card__body">
              <span class="card__top">
                <span class="card__company display" transition:name={`company-${c.id}`}>{c.data.company}</span>
                <span class="card__type pill pill--muted">{c.data.type}</span>
              </span>
              <span class="card__line">{c.data.cardLine}</span>
              <Stages lit={c.data.stages} size="sm" quiet />
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="empty" data-empty hidden>No case matches both filters. Try another stage or industry.</p>

    <a class="lab" href={u('lab')} data-reveal>
      <span class="lab__label">Lab</span>
      <span class="lab__text">Research and strategy work that didn't need a full case page.</span>
    </a>
  </section>
</Base>

<script>
  import { gsap } from 'gsap';
  import { Flip } from 'gsap/Flip';
  gsap.registerPlugin(Flip);

  function bindFilters() {
    const root = document.querySelector<HTMLElement>('[data-filters]');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    if (!root || !cards.length) return;
    const state = { stage: 'all', industry: 'all' };
    const reduce = !document.documentElement.classList.contains('js-motion');

    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      const key = btn.dataset.filter as 'stage' | 'industry';
      state[key] = btn.dataset.value || 'all';
      root.querySelectorAll<HTMLButtonElement>(`[data-filter="${key}"]`).forEach((b) => {
        const on = b === btn;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', String(on));
      });

      const flip = reduce ? null : Flip.getState(cards);
      let shown = 0;
      cards.forEach((c) => {
        const okStage = state.stage === 'all' || (c.dataset.stages || '').split(' ').includes(state.stage);
        const okInd = state.industry === 'all' || (c.dataset.industry || '').split('|').includes(state.industry);
        const show = okStage && okInd;
        c.hidden = !show;
        if (show) shown++;
      });
      if (empty) empty.hidden = shown > 0;
      if (flip) {
        Flip.from(flip, {
          duration: 0.7, ease: 'expo.out', absolute: true, nested: true,
          onEnter: (els) => gsap.fromTo(els, { opacity: 0, scale: 0.96 }, { opacity: 1, scale: 1, duration: 0.6, ease: 'expo.out' }),
          onLeave: (els) => gsap.to(els, { opacity: 0, scale: 0.96, duration: 0.3 }),
        });
      }
    });
  }
  document.addEventListener('astro:page-load', bindFilters);
</script>

<style>
  .work { padding-top: clamp(120px, 14vw, 180px); }
  .work__intro { font-size: clamp(18px, 1.6vw, 22px); max-width: 44ch; margin-bottom: 40px; }

  .filters { display: grid; gap: 12px; margin-bottom: clamp(36px, 5vw, 56px); }
  .filters__row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .filters__label { width: 80px; font-size: 14px; color: var(--text-muted); }
  .chip {
    border: 1.5px solid var(--line); border-radius: 999px;
    padding: 8px 15px; font-size: 14px; font-weight: 500; line-height: 1.2;
    color: var(--text-muted);
    transition: background-color 300ms var(--ease-out), color 300ms var(--ease-out), border-color 300ms var(--ease-out);
  }
  .chip:hover { color: var(--text); border-color: var(--line-strong); }
  .chip.is-on { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }

  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(16px, 2vw, 28px); }
  .card[hidden] { display: none; }
  .card__link {
    display: grid; height: 100%;
    border-radius: 20px; overflow: hidden;
    background: var(--bg-elev); border: 1px solid var(--line);
    transition: border-color 400ms var(--ease-out), transform 600ms var(--ease-out);
  }
  .card__media { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface); position: relative; }
  .card__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; transition: transform 900ms var(--ease-out); }
  .card__logo { position: absolute; inset: 0; display: grid; place-items: center; padding: 15%; background: radial-gradient(circle at 50% 40%, rgba(255,255,255,0.06), transparent 70%); }
  .card__logo :global(img) { width: auto !important; height: auto; max-height: 120px; max-width: 70%; object-fit: contain; }
  .card__mono { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; text-align: center; font-size: clamp(36px, 4vw, 56px); color: var(--line-strong); }
  .card__body { display: grid; gap: 14px; padding: clamp(20px, 2.4vw, 28px); }
  .card__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .card__company { font-size: clamp(28px, 2.6vw, 38px); line-height: 0.95; transition: color 300ms; }
  .card__type { flex: none; font-size: 12px; padding: 4px 10px; }
  .card__line { color: var(--text-muted); line-height: 1.5; }
  @media (hover: hover) {
    .card__link:hover { border-color: var(--line-strong); transform: translateY(-6px); }
    .card__link:hover .card__media :global(img) { transform: scale(1.04); }
    .card__link:hover .card__company { color: var(--accent); }
  }
  .empty { margin-top: 24px; color: var(--text-muted); }

  .lab {
    display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: 24px;
    margin-top: clamp(48px, 6vw, 80px); padding: 28px 0;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .lab__label { font-family: var(--font-display); text-transform: uppercase; font-size: clamp(40px, 5vw, 72px); line-height: 0.9; transition: color 300ms; }
  .lab:hover .lab__label { color: var(--accent); }
  .lab__text { color: var(--text-muted); }

  @media (max-width: 860px) {
    .cards { grid-template-columns: 1fr; }
    .filters__label { width: 100%; }
    .lab { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
